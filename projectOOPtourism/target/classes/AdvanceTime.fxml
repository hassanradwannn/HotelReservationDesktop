<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>

<VBox spacing="10" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="AdvanceTimeController">
    <Label text="Advance System Time" textFill="WHITE" style="-fx-font-family: 'Georgia'; -fx-font-size: 29;"/>
    <Label fx:id="todayLabel" textFill="WHITE" style="-fx-font-size: 15;"/>
    <TextField fx:id="daysField" promptText="Days to advance" maxWidth="360" style="-fx-background-color: #FFFFFF; -fx-background-radius: 8; -fx-border-color: #C9AA7C; -fx-border-radius: 8; -fx-padding: 10; -fx-font-size: 14px; -fx-text-fill: #2B2421;"/>
    <Button text="ADVANCE TIME" prefWidth="190" prefHeight="42" onAction="#handleAdvanceTime" style="-fx-background-color: #C74261; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 7; -fx-font-size: 13px; -fx-cursor: hand;"/>
</VBox>
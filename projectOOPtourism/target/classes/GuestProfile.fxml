<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="10" style="-fx-padding: 20;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="GuestProfileController">
    <children>
        <Label text="My Profile" style="-fx-text-fill: black;">
            <font><Font name="Georgia" size="29.0" /></font>
        </Label>
        <Label fx:id="usernameLabel" style="-fx-text-fill: black;">
            <font><Font name="Arial" size="15.0" /></font>
        </Label>
        <Label fx:id="dobLabel" style="-fx-text-fill: black;">
            <font><Font name="Arial" size="15.0" /></font>
        </Label>
        <Label fx:id="balanceLabel" style="-fx-text-fill: black;">
            <font><Font name="Arial" size="15.0" /></font>
        </Label>
        <Label fx:id="addressLabel" style="-fx-text-fill: black;">
            <font><Font name="Arial" size="15.0" /></font>
        </Label>
        <Label fx:id="genderLabel" style="-fx-text-fill: black;">
            <font><Font name="Arial" size="15.0" /></font>
        </Label>
        <Label fx:id="prefsLabel" style="-fx-text-fill: black;">
            <font><Font name="Arial" size="15.0" /></font>
        </Label>
    </children>
</VBox>
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="720.0" prefWidth="1280.0" styleClass="root-pane" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ForgotPasswordController">
   <children>
      <StackPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <VBox alignment="CENTER" maxWidth="470.0" spacing="16.0" style="-fx-background-color: #F9F3EA; -fx-background-radius: 24; -fx-effect: dropshadow(gaussian, rgba(80,45,35,0.16), 24, 0.25, 0, 7);">
               <padding>
                  <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
               </padding>
               <children>
                  <Label text="GRAND BUDAPEST HOTEL" textFill="#8f1d3f"><font><Font name="Georgia" size="13.0" /></font></Label>
                  <Label text="Reset Password" textFill="#2b2421"><font><Font name="Georgia" size="29.0" /></font></Label>
                  <Label text="Enter your details to reset your password" textFill="#8a726b" />
                  
                  <TextField fx:id="usernameField" maxWidth="360.0" promptText="Username" styleClass="input-field" />
                  <TextField fx:id="dobField" maxWidth="360.0" promptText="Date of Birth DD-MM-YYYY" styleClass="input-field" />
                  
                  <Separator maxWidth="360.0" style="-fx-background-color: transparent; -fx-padding: 5 0 5 0;" />
                  
                  <PasswordField fx:id="newPasswordField" maxWidth="360.0" promptText="New Password" styleClass="input-field" />
                  <PasswordField fx:id="confirmPasswordField" maxWidth="360.0" promptText="Confirm New Password" styleClass="input-field" />
                  
                  <Label fx:id="messageLabel" textFill="#c74261" />
                  
                  <Button mnemonicParsing="false" onAction="#handleResetPassword" prefHeight="45.0" prefWidth="240.0" styleClass="main-btn" text="RESET PASSWORD" />
                  <Button mnemonicParsing="false" onAction="#handleBack" prefHeight="42.0" prefWidth="180.0" styleClass="outline-btn" text="BACK TO LOGIN" />
               </children>
            </VBox>
         </children>
      </StackPane>
   </children>
</AnchorPane>
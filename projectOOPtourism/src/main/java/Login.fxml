<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="720.0" prefWidth="1280.0" styleClass="root-pane" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="LoginController">
   <children>
      <HBox layoutX="140.0" layoutY="60.0" prefHeight="600.0" prefWidth="1000.0" styleClass="card-container">
         <children>

            <!-- Left Side: Login Form -->
            <VBox alignment="CENTER" prefWidth="500.0" spacing="18.0" styleClass="left-panel">
               <padding>
                  <Insets bottom="45.0" left="45.0" right="45.0" top="45.0" />
               </padding>
               <children>
                  <Label text="GRAND BUDAPEST HOTEL" textFill="#8f1d3f">
                     <font><Font name="Georgia" size="13.0" /></font>
                  </Label>
                  <Label text="WELCOME BACK" textFill="#2b2421">
                     <font><Font name="Georgia" size="34.0" /></font>
                  </Label>
                  <Label text="Sign in to continue your reservation experience" textFill="#8a726b" />

                  <TextField fx:id="usernameField" maxWidth="360.0" promptText="Username" styleClass="input-field" />
                  <PasswordField fx:id="passwordField" maxWidth="350.0" promptText="Password" styleClass="input-field" />

                  <Button fx:id="loginBtn" mnemonicParsing="false" onAction="#handleLogin" prefHeight="45.0" prefWidth="210.0" styleClass="main-btn" text="SIGN IN">
                     <font>
                        <Font size="15.0" />
                     </font></Button>
                  <Button mnemonicParsing="false" onAction="#handleRegister" prefHeight="42.0" prefWidth="210.0" styleClass="outline-btn" text="REGISTER AS GUEST" />

                  <Label fx:id="messageLabel" textFill="#c74261" />
                  <Label maxWidth="360.0" text="Demo users: Admin / Admin@123 | Hassan / Hassan123 | Manar / Manar2002" textFill="#8a726b" wrapText="true" />
               </children>
            </VBox>

            <!-- Right Side: Hotel Info -->
            <VBox alignment="CENTER_LEFT" prefWidth="500.0" spacing="16.0" styleClass="right-panel">
               <padding>
                  <Insets bottom="65.0" left="65.0" right="65.0" top="65.0" />
               </padding>
               <children>
                  <Label text="EXPERIENCE EGYPTIAN HOTELS LIKE NEVER BEFORE" textFill="#8f1d3f" />
                  <Label text="RESERVE YOUR&#10;SUITE" textFill="#2b2421">
                     <font><Font name="Georgia" size="42.0" /></font>
                  </Label>
                  <Label text="Cairo, Arab Republic of Egypt" textFill="#8f1d3f" />
                  <Separator maxWidth="270.0" style="-fx-background-color: #C9AA7C;" />
                  <Button mnemonicParsing="false" onAction="#handleRegister" prefHeight="45.0" prefWidth="160.0" styleClass="book-btn" text="BOOK NOW">
                     <font>
                        <Font size="14.0" />
                     </font></Button>
               </children>
            </VBox>

         </children>
      </HBox>
   </children>
</AnchorPane>

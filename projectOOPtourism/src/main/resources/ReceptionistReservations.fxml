<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="0" style="-fx-padding: 30 44 30 44; -fx-background-color: transparent;"
      stylesheets="@styles.css"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ReceptionistReservationsController">
    <children>
        <HBox alignment="BOTTOM_LEFT" spacing="18">
            <children>
                <VBox spacing="0" HBox.hgrow="ALWAYS">
                    <Label styleClass="section-eyebrow" text="ADMINISTRATION" />
                    <Label fx:id="titleLabel" styleClass="section-heading" text="Reservations" />
                </VBox>
                <Button fx:id="allButton" onAction="#showAllReservations" prefHeight="38" text="ALL" styleClass="outline-action-btn" />
            </children>
        </HBox>

        <Region prefHeight="20" />

        <HBox spacing="14">
            <children>
                <VBox fx:id="checkInTab" onMouseClicked="#showCheckingIn" spacing="6" styleClass="reception-tab-card">
                    <children>
                        <Label styleClass="reception-tab-label" text="CHECK INS TODAY" />
                        <Label fx:id="checkInCountLabel" styleClass="reception-tab-count" text="0" />
                    </children>
                </VBox>
                <VBox fx:id="checkOutTab" onMouseClicked="#showCheckingOut" spacing="6" styleClass="reception-tab-card">
                    <children>
                        <Label styleClass="reception-tab-label" text="CHECK OUT REQUESTS" />
                        <Label fx:id="checkOutCountLabel" styleClass="reception-tab-count" text="0" />
                    </children>
                </VBox>
                <VBox fx:id="residingTab" onMouseClicked="#showResidingGuests" spacing="6" styleClass="reception-tab-card">
                    <children>
                        <Label styleClass="reception-tab-label" text="GUESTS RESIDING" />
                        <Label fx:id="residingCountLabel" styleClass="reception-tab-count" text="0" />
                    </children>
                </VBox>
            </children>
        </HBox>

        <Region prefHeight="18" />

        <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER"
                    style="-fx-background: transparent; -fx-background-color: transparent; -fx-border-color: transparent; -fx-padding: 0;"
                    VBox.vgrow="ALWAYS">
            <content>
                <VBox fx:id="cardsContainer" spacing="14"
                      style="-fx-background-color: transparent; -fx-padding: 2 2 20 2;" />
            </content>
        </ScrollPane>
    </children>
</VBox>

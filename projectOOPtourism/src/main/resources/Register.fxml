<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="720.0" prefWidth="1280.0" styleClass="root-pane" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="RegisterController">
   <children>
      <HBox AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">

         <!-- Left Panel: Branding -->
         <VBox prefWidth="520.0" styleClass="login-left-panel" alignment="BOTTOM_LEFT">
            <children>

               <VBox VBox.vgrow="ALWAYS" alignment="CENTER_LEFT" spacing="18">
                  <padding><Insets top="60" left="65" right="65" bottom="60"/></padding>
                  <children>
                     <Label text="A" styleClass="hero-text-light" textFill="#F9F3EA" style="-fx-text-fill: #F9F3EA;"/>
                     <Label text="sanctuary" styleClass="hero-text-italic" textFill="#C8B8B0" style="-fx-text-fill: #C8B8B0;"/>
                     <Label text="for the discerning" styleClass="hero-text-light" textFill="#F9F3EA" style="-fx-text-fill: #F9F3EA;"/>
                     <Label text="traveler" styleClass="hero-text-light" textFill="#F9F3EA" style="-fx-text-fill: #F9F3EA;"/>
                     <Region prefHeight="16"/>
                     <Label text="A glimmer of civilization in this barbaric slaughterhouse. Dedicated to the highest standards of hospitality." styleClass="hero-subtext" textFill="#D4C4BC" style="-fx-text-fill: #D4C4BC;" wrapText="true" maxWidth="380"/>
                  </children>
               </VBox>

               <Label text="Est. 1908  ·  Cairo, Arab Republic of Egypt" styleClass="hotel-footer-label" textFill="#B8A89E" style="-fx-text-fill: #B8A89E;">
                  <padding><Insets left="65" bottom="35"/></padding>
               </Label>
            </children>
         </VBox>

         <!-- Right Panel: Register Form -->
         <VBox prefWidth="760.0" styleClass="login-right-panel" alignment="TOP_LEFT">
            <children>

               <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="transparent-scroll">
                  <content>
                     <VBox alignment="CENTER_LEFT" spacing="18">
                        <padding><Insets top="50" left="100" right="100" bottom="50"/></padding>
                        <children>
                           <Label text="WELCOME TO THE GRAND BUDAPEST HOTEL" styleClass="form-eyebrow" textFill="#C4415D" style="-fx-text-fill: #C4415D;"/>
                           <Label text="Begin your history with us" styleClass="form-title" textFill="#2C2523" style="-fx-text-fill: #2C2523;"/>

                           <Region prefHeight="8"/>

                           <TextField fx:id="usernameField" promptText="username" styleClass="elegant-input" maxWidth="480"/>
                           <PasswordField fx:id="passwordField" promptText="password" styleClass="elegant-input" maxWidth="480"/>
                           <TextField fx:id="balanceField" promptText="balance" styleClass="elegant-input" maxWidth="480"/>

                           <HBox spacing="16" alignment="CENTER_LEFT" maxWidth="480">
                              <TextField fx:id="dobField" promptText="date of birth  YYYY-MM-DD" styleClass="elegant-input" HBox.hgrow="ALWAYS"/>
                              <ComboBox fx:id="genderBox" promptText="Gender" styleClass="elegant-input combo-box" prefWidth="150"/>
                           </HBox>

                           <TextField fx:id="prefsField" promptText="room preferences" styleClass="elegant-input" maxWidth="480"/>
                           <TextField fx:id="addressField" promptText="address" styleClass="elegant-input" maxWidth="480"/>

                           <Region prefHeight="4"/>

                           <Button text="REGISTER AS PATRON" onAction="#handleRegister" prefHeight="50" prefWidth="260" styleClass="primary-action-btn"/>

                           <HBox spacing="6" alignment="CENTER_LEFT">
                              <Label text="Already on the ledger?" styleClass="form-link-italic"/>
                              <Hyperlink text="Sign in here" onAction="#handleSignInLink" styleClass="form-link"/>
                           </HBox>

                           <Label fx:id="messageLabel" styleClass="message-label" wrapText="true" maxWidth="480"/>
                        </children>
                     </VBox>
                  </content>
               </ScrollPane>
            </children>
         </VBox>

      </HBox>
   </children>
</AnchorPane>

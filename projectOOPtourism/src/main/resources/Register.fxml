<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="720.0" prefWidth="1280.0" styleClass="root-pane" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="RegisterController">
   <children>
      <StackPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <VBox alignment="CENTER" maxWidth="470.0" spacing="14.0" style="-fx-background-color: #F9F3EA; -fx-background-radius: 24; -fx-effect: dropshadow(gaussian, rgba(80,45,35,0.16), 24, 0.25, 0, 7);">
               <padding>
                  <Insets bottom="35.0" left="35.0" right="35.0" top="35.0" />
               </padding>
               <children>
                  <Label text="GRAND BUDAPEST HOTEL" textFill="#8f1d3f"><font><Font name="Georgia" size="13.0" /></font></Label>
                  <Label text="Guest Registration" textFill="#2b2421"><font><Font name="Georgia" size="29.0" /></font></Label>
                  
                  <TextField fx:id="usernameField" maxWidth="360.0" promptText="Username" styleClass="input-field" />
                  <PasswordField fx:id="passwordField" maxWidth="360.0" promptText="Password: min 8 chars, uppercase, digit" styleClass="input-field" />
                  <TextField fx:id="dobField" maxWidth="360.0" promptText="Date of Birth YYYY-MM-DD" styleClass="input-field" />
                  <TextField fx:id="balanceField" maxWidth="360.0" promptText="Balance" styleClass="input-field" />
                  <TextField fx:id="addressField" maxWidth="360.0" promptText="Address" styleClass="input-field" />
                  <ComboBox fx:id="genderBox" maxWidth="360.0" promptText="Gender" />
                  <TextField fx:id="prefsField" maxWidth="360.0" promptText="Room Preferences" styleClass="input-field" />
                  <HBox alignment="CENTER" spacing="5">
                     <Label text="Already registered?" style="-fx-text-fill: #2B2421; -fx-font-size: 14px;" />
                     <Hyperlink text="Sign in here" onAction="#handleSignInLink" style="-fx-text-fill: #C74261; -fx-font-size: 14px; -fx-font-weight: bold; -fx-border-color: transparent;" />
                  </HBox>
                  <Label fx:id="messageLabel" textFill="#c74261" />
                  
                  <Button mnemonicParsing="false" onAction="#handleRegister" prefHeight="45.0" prefWidth="240.0" styleClass="main-btn" text="CREATE ACCOUNT" />
                  <Button mnemonicParsing="false" onAction="#handleBack" prefHeight="42.0" prefWidth="180.0" styleClass="outline-btn" text="BACK" />
               </children>
            </VBox>
         </children>
      </StackPane>
   </children>
</AnchorPane>
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.text.Font?>

<VBox spacing="0" style="-fx-padding: 10;" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="PayDepositController">
    <children>
       <Label text="BILLING" styleClass="panel-eyebrow"/>
       <Label text="Pay Deposit" styleClass="panel-title"/>
       <Region prefHeight="18"/>

       <VBox spacing="14" styleClass="form-card" maxWidth="500">
          <children>
             <ComboBox fx:id="pendingCombo" maxWidth="420.0" onAction="#handleSelection" promptText="Select Pending Reservation" styleClass="elegant-input"/>
             <Label fx:id="detailsLabel" text="Choose a reservation." styleClass="profile-field"/>
             <ComboBox fx:id="paymentCombo" maxWidth="420.0" promptText="Payment Method" styleClass="elegant-input"/>
             <Button mnemonicParsing="false" onAction="#handlePay" prefHeight="44.0" prefWidth="180.0" text="PAY DEPOSIT" styleClass="primary-action-btn"/>
          </children>
       </VBox>
    </children>
</VBox>

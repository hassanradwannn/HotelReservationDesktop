<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Controllers.GuestHomeController"
      styleClass="guest-home-root"
      stylesheets="@styles.css"
      spacing="0">

    <VBox fx:id="heroArea" styleClass="guest-hero" spacing="6" alignment="TOP_LEFT">
        <padding><Insets top="36" right="60" bottom="40" left="60"/></padding>

        <HBox spacing="18" alignment="TOP_LEFT">
            <VBox spacing="6" HBox.hgrow="ALWAYS">
               <HBox spacing="0">
                  <Label text="A most " styleClass="hero-bold"/>
                  <Label text="distinguished" styleClass="hero-italic"/>
               </HBox>
               <Label text="stay awaits you" styleClass="hero-bold"/>
               <Label fx:id="heroSubLabel" text="Begin curating your stay and exploring our finest offerings" styleClass="hero-sub"/>
            </VBox>
            <Label fx:id="heroDateLabel" text="Date: DD/MM/YYYY" styleClass="guest-date-label"/>
        </HBox>

        <VBox fx:id="searchArea" styleClass="search-card-inner" spacing="0">
            <VBox.margin><Insets top="24"/></VBox.margin>
            <padding><Insets top="18" right="24" bottom="18" left="24"/></padding>

            <Label text="RESERVE YOUR SUITE" styleClass="search-card-eyebrow"/>
            <HBox spacing="12" styleClass="search-fields-row" alignment="BOTTOM_LEFT">

                <VBox styleClass="search-field-group" HBox.hgrow="ALWAYS">
                    <Label text="CHECK-IN" styleClass="search-field-label"/>
                    <DatePicker fx:id="checkInPicker" maxWidth="Infinity"
                                promptText="DD/MM/YYYY" styleClass="search-date-picker"/>
                </VBox>

                <VBox styleClass="search-field-group" HBox.hgrow="ALWAYS">
                    <Label text="CHECK-OUT" styleClass="search-field-label"/>
                    <DatePicker fx:id="checkOutPicker" maxWidth="Infinity"
                                promptText="DD/MM/YYYY" styleClass="search-date-picker"/>
                </VBox>

                <VBox styleClass="search-field-group">
                    <Label text="GUESTS" styleClass="search-field-label"/>
                    <Spinner fx:id="guestsSpinner" styleClass="search-spinner" prefWidth="100" editable="true"/>
                </VBox>

                <VBox styleClass="search-field-group" HBox.hgrow="ALWAYS">
                    <Label text="BUDGET" styleClass="search-field-label"/>
                    <TextField fx:id="maxPriceField" styleClass="search-field-input" promptText="Any"/>
                </VBox>

                <VBox styleClass="search-field-group" HBox.hgrow="ALWAYS">
                    <Label text="ROOM TYPE" styleClass="search-field-label"/>
                    <ComboBox fx:id="typeCombo" styleClass="search-field-combo"
                              promptText="Any type" maxWidth="Infinity"/>
                </VBox>

                <Button text="SEARCH" onAction="#handleSearch"
                        styleClass="hero-search-btn" minWidth="124" prefHeight="42" minHeight="42" maxHeight="42"/>
            </HBox>
            <VBox spacing="6">
                <padding><Insets top="12" bottom="2"/></padding>
                <Label text="AMENITIES" styleClass="search-field-label"/>
                <FlowPane fx:id="amenityPillsPane" hgap="8" vgap="6"/>
            </VBox>

            <Label fx:id="msgLabel" text="" styleClass="search-error-label" wrapText="true">
                <padding><Insets top="6"/></padding>
            </Label>
        </VBox>

    </VBox>

    <VBox fx:id="resultsArea" spacing="0" visible="false" managed="false" VBox.vgrow="ALWAYS">
        <VBox styleClass="results-summary-band" spacing="22">
            <padding><Insets top="28" right="48" bottom="22" left="48"/></padding>
            <HBox alignment="CENTER_LEFT" spacing="26">
                <VBox spacing="3">
                    <Label text="CHECK-IN" styleClass="summary-label"/>
                    <Label fx:id="summaryCheckInLabel" text="-" styleClass="summary-value"/>
                </VBox>
                <Region styleClass="summary-divider"/>
                <VBox spacing="3">
                    <Label text="CHECK-OUT" styleClass="summary-label"/>
                    <Label fx:id="summaryCheckOutLabel" text="-" styleClass="summary-value"/>
                </VBox>
                <Region styleClass="summary-divider"/>
                <VBox spacing="3">
                    <Label text="GUESTS" styleClass="summary-label"/>
                    <Label fx:id="summaryGuestsLabel" text="-" styleClass="summary-value"/>
                </VBox>
                <Region styleClass="summary-divider"/>
                <VBox spacing="3">
                    <Label text="BUDGET" styleClass="summary-label"/>
                    <Label fx:id="summaryBudgetLabel" text="-" styleClass="summary-value"/>
                </VBox>
                <Region styleClass="summary-divider"/>
                <VBox spacing="3">
                    <Label text="ROOM TYPE" styleClass="summary-label"/>
                    <Label fx:id="summaryTypeLabel" text="-" styleClass="summary-value"/>
                </VBox>
                <Region styleClass="summary-divider"/>
                <VBox spacing="3">
                    <Label text="AMENITIES" styleClass="summary-label"/>
                    <Label fx:id="summaryAmenitiesLabel" text="-" styleClass="summary-value"/>
                </VBox>
            </HBox>
            <Button text="MODIFY SEARCH" onAction="#handleModifySearch" styleClass="modify-search-btn" prefWidth="190" prefHeight="44"/>
        </VBox>

        <VBox styleClass="results-list-shell" spacing="22" VBox.vgrow="ALWAYS">
            <padding><Insets top="22" right="48" bottom="36" left="48"/></padding>
            <Label fx:id="resultsCountLabel" text="0 rooms available" styleClass="results-count-label"/>
            <ScrollPane styleClass="transparent-scroll" fitToWidth="true" VBox.vgrow="ALWAYS">
                <VBox fx:id="resultsPane" spacing="16"/>
            </ScrollPane>
        </VBox>
    </VBox>

    <HBox fx:id="quickCardsArea" spacing="24" VBox.vgrow="ALWAYS" alignment="TOP_LEFT">
        <padding><Insets top="28" right="48" bottom="28" left="48"/></padding>

        <VBox styleClass="quick-card-rose" spacing="16" minWidth="216" prefWidth="216" maxWidth="Infinity" maxHeight="Infinity" HBox.hgrow="ALWAYS">
            <padding><Insets top="24" right="20" bottom="24" left="20"/></padding>
            <VBox spacing="6">
                <Label text="MY RESERVATIONS" styleClass="quick-card-link" onMouseClicked="#showReservations"/>
                <Label text="PAYMENTS" styleClass="quick-card-link" onMouseClicked="#showDeposit"/>
            </VBox>
            <Region VBox.vgrow="ALWAYS"/>
            <Label text="View your secure arrangements, including suite type and check-in times."
                   styleClass="quick-card-body" wrapText="true"/>
        </VBox>

        <VBox styleClass="quick-card-cream" spacing="16" minWidth="216" prefWidth="216" maxWidth="Infinity" maxHeight="Infinity" HBox.hgrow="ALWAYS" onMouseClicked="#showChat">
            <padding><Insets top="24" right="20" bottom="24" left="20"/></padding>
            <Label text="THE FRONT DESK" styleClass="quick-card-link-dark"/>
            <Region VBox.vgrow="ALWAYS"/>
            <Label text="&quot;Good day to you. I am at your service. How may I assist in the orchestration of your stay this afternoon?&quot;"
                   styleClass="quick-card-quote" wrapText="true"/>
        </VBox>

        <VBox styleClass="quick-card-burgundy" spacing="16" minWidth="216" prefWidth="216" maxWidth="Infinity" maxHeight="Infinity" HBox.hgrow="ALWAYS" onMouseClicked="#showProfile">
            <padding><Insets top="24" right="20" bottom="24" left="20"/></padding>
            <Label text="PATRON'S DOSSIER" styleClass="quick-card-link-light"/>
            <Region VBox.vgrow="ALWAYS"/>
            <Label text="A meticulously maintained record is the foundation of impeccable service."
                   styleClass="quick-card-body-light" wrapText="true"/>
        </VBox>

        <VBox styleClass="quick-card-cream" spacing="12" minWidth="216" prefWidth="216" maxWidth="Infinity" maxHeight="Infinity" HBox.hgrow="ALWAYS">
            <padding><Insets top="24" right="20" bottom="24" left="20"/></padding>
            <Label text="DIRECTOR'S CABINET" styleClass="quick-card-muted"/>
            <Region VBox.vgrow="ALWAYS"/>
            <Button text="FAST FORWARD" onAction="#showTime"
                    styleClass="outline-action-btn" maxWidth="Infinity"/>
            <Button text="DEPART THE PREMISE" onAction="#doLogout"
                    styleClass="outline-action-btn" maxWidth="Infinity"/>
        </VBox>

    </HBox>

</VBox>

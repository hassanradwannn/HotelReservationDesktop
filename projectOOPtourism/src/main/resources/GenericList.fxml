<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.text.Font?>

<VBox spacing="0" style="-fx-padding: 10;" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="GenericListController">
    <children>
       <Label fx:id="eyebrowLabel" text="RECORDS" styleClass="panel-eyebrow"/>
       <Label fx:id="titleLabel" text="List" styleClass="panel-title"/>
       <Region prefHeight="18"/>
       <ListView fx:id="listView" prefHeight="470.0" styleClass="elegant-list"/>
    </children>
</VBox>

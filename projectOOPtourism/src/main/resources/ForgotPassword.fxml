<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="720.0" prefWidth="1280.0" styleClass="root-pane" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ForgotPasswordController">
   <children>
      <HBox AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">

         <!-- Left branding panel -->
         <VBox prefWidth="480.0" styleClass="login-left-panel" alignment="BOTTOM_LEFT">
            <children>
               <VBox VBox.vgrow="ALWAYS" alignment="CENTER_LEFT" spacing="16">
                  <padding><Insets top="60" left="65" right="65" bottom="60"/></padding>
                  <children>
                     <Label text="Forgotten?" styleClass="hero-text-light" textFill="#F9F3EA" style="-fx-text-fill: #F9F3EA;"/>
                     <Label text="We remember" styleClass="hero-text-italic" textFill="#C8B8B0" style="-fx-text-fill: #C8B8B0;"/>
                     <Label text="everything." styleClass="hero-text-light" textFill="#F9F3EA" style="-fx-text-fill: #F9F3EA;"/>
                     <Region prefHeight="14"/>
                     <Label text="The finest establishments never forget their guests. Let us help you return." styleClass="hero-subtext" textFill="#D4C4BC" style="-fx-text-fill: #D4C4BC;" wrapText="true" maxWidth="360"/>
                  </children>
               </VBox>
               <Label text="Est. 1908  ·  Cairo, Arab Republic of Egypt" styleClass="hotel-footer-label" textFill="#B8A89E" style="-fx-text-fill: #B8A89E;">
                  <padding><Insets left="65" bottom="35"/></padding>
               </Label>
            </children>
         </VBox>

         <!-- Right form panel -->
         <VBox prefWidth="800.0" styleClass="login-right-panel" alignment="TOP_LEFT">
            <children>
               <VBox VBox.vgrow="ALWAYS" alignment="CENTER_LEFT" spacing="20">
                  <padding><Insets top="60" left="100" right="100" bottom="60"/></padding>
                  <children>
                     <Label text="PASSWORD RECOVERY" styleClass="form-eyebrow" textFill="#C4415D" style="-fx-text-fill: #C4415D;"/>
                     <Label text="Reset your password" styleClass="form-title" textFill="#2C2523" style="-fx-text-fill: #2C2523;"/>
                     <Region prefHeight="8"/>
                     <TextField fx:id="usernameField" promptText="username" styleClass="elegant-input" maxWidth="460"/>
                     <DatePicker fx:id="dobPicker" promptText="date of birth  DD/MM/YYYY" styleClass="date-picker" maxWidth="460"/>
                     <Separator maxWidth="460" styleClass="form-sep"/>
                     <PasswordField fx:id="newPasswordField" promptText="new password" styleClass="elegant-input" maxWidth="460"/>
                     <PasswordField fx:id="confirmPasswordField" promptText="confirm new password" styleClass="elegant-input" maxWidth="460"/>
                     <Label fx:id="messageLabel" styleClass="message-label" wrapText="true" maxWidth="460"/>
                     <Button text="RESET PASSWORD" onAction="#handleResetPassword" prefHeight="50" prefWidth="240" styleClass="primary-action-btn"/>
                     <Hyperlink text="← Back to login" onAction="#handleBack" styleClass="form-link"/>
                  </children>
               </VBox>
            </children>
         </VBox>
      </HBox>
   </children>
</AnchorPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>

<VBox spacing="0" style="-fx-padding: 10;" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="GuestProfileController">
    <children>
       <Label text="ACCOUNT" styleClass="panel-eyebrow"/>
       <Label text="My Profile" styleClass="panel-title"/>
       <Region prefHeight="18"/>

       <VBox spacing="14" styleClass="form-card" maxWidth="500">
          <children>
             <Label fx:id="usernameLabel" styleClass="profile-field"/>
             <Label fx:id="dobLabel" styleClass="profile-field"/>
             <Label fx:id="balanceLabel" styleClass="profile-field"/>
             <Label fx:id="addressLabel" styleClass="profile-field"/>
             <Label fx:id="genderLabel" styleClass="profile-field"/>
             <Label fx:id="prefsLabel" styleClass="profile-field"/>
          </children>
       </VBox>
    </children>
</VBox>

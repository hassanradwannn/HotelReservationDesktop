<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" spacing="20.0" style="-fx-background-color: #F7EFE5; -fx-padding: 20;" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="AddReceptionistController">
    <children>
        <Label text="Register Receptionist" styleClass="section-title">
            <font>
                <Font name="Georgia" size="29.0" />
            </font>
        </Label>
        <TextField fx:id="usernameField" maxWidth="360.0" promptText="Username" styleClass="input-field" />
        <PasswordField fx:id="passwordField" maxWidth="360.0" promptText="Password" styleClass="input-field" />
        <TextField fx:id="dobField" maxWidth="360.0" promptText="DOB DD-MM-YYYY" styleClass="input-field" />
        <TextField fx:id="hoursField" maxWidth="360.0" promptText="Working Hours" styleClass="input-field" />
        <Button onAction="#handleRegister" prefHeight="42.0" prefWidth="170.0" text="REGISTER" styleClass="main-button" />
    </children>
</VBox>
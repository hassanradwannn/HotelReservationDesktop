<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="0" style="-fx-padding: 10;" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="LiveChatController">
    <children>
       <Label text="CONCIERGE" styleClass="panel-eyebrow"/>
       <Label text="Live Reception Chat" styleClass="panel-title"/>
       <Region prefHeight="14"/>

       <VBox styleClass="chat-card" VBox.vgrow="ALWAYS" spacing="14">
          <children>
             <HBox spacing="14" alignment="CENTER_LEFT">
                <StackPane prefWidth="46" prefHeight="46" style="-fx-background-color: #C74261; -fx-background-radius: 50;">
                   <Label fx:id="avatarLabel" text="U" style="-fx-text-fill: WHITE; -fx-font-weight: bold; -fx-font-size: 20;"/>
                </StackPane>
                <VBox spacing="2">
                   <Label text="Hotel Live Chat" styleClass="chat-name"/>
                   <Label fx:id="chatStatus" text="Connected to reception desk" styleClass="chat-status"/>
                </VBox>
             </HBox>

             <TextArea fx:id="chatArea" editable="false" prefHeight="380" styleClass="chat-area" wrapText="true" VBox.vgrow="ALWAYS"/>

             <HBox spacing="10" alignment="CENTER">
                <TextField fx:id="inputField" promptText="Write your message..." HBox.hgrow="ALWAYS" onAction="#handleSend" styleClass="elegant-input"/>
                <Button text="SEND" prefWidth="110" prefHeight="44" onAction="#handleSend" styleClass="primary-action-btn"/>
             </HBox>
          </children>
       </VBox>
    </children>
</VBox>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.text.Font?>

<VBox spacing="0" style="-fx-padding: 10;" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ManageAmenitiesController">
    <children>
       <Label text="ADMINISTRATION" styleClass="panel-eyebrow"/>
       <Label text="Manage Amenities" styleClass="panel-title"/>
       <Region prefHeight="18"/>

       <VBox spacing="14" styleClass="form-card" maxWidth="500">
          <children>
             <TextField fx:id="nameField" maxWidth="420.0" promptText="Amenity Name" styleClass="elegant-input"/>
             <TextField fx:id="priceField" maxWidth="420.0" promptText="Price" styleClass="elegant-input"/>
             <Button onAction="#handleAdd" prefHeight="44.0" prefWidth="180.0" text="ADD AMENITY" styleClass="primary-action-btn"/>
          </children>
       </VBox>

       <Region prefHeight="20"/>
       <ListView fx:id="listView" prefHeight="360.0" styleClass="elegant-list"/>
    </children>
</VBox>

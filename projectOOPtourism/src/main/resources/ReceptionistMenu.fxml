<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>

<HBox alignment="CENTER_LEFT" spacing="0" styleClass="topnav" stylesheets="@styles.css"
      xmlns="http://javafx.com/javafx/19"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ReceptionistMenuController">
    <Button fx:id="btnReservations" text="RESERVATIONS"  onAction="#showAllReservations" styleClass="nav-btn, nav-btn-active" />
    <Button fx:id="btnGuests"       text="GUESTS"        onAction="#showGuests"          styleClass="nav-btn" />
    <Button fx:id="btnRooms"        text="ROOMS"         onAction="#showRooms"           styleClass="nav-btn" />
    <Button fx:id="btnChat"         text="LIVE CHAT"     onAction="#showChat"            styleClass="nav-btn" />
    <Button fx:id="btnTime"         text="ADVANCE TIME"  onAction="#showTime"            styleClass="nav-btn" />
    <Region HBox.hgrow="ALWAYS"/>
    <Button fx:id="btnLogout"       text="LOGOUT"        onAction="#doLogout"            styleClass="nav-btn-logout" />
</HBox>

<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>

<VBox alignment="CENTER" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="EditRoomController">
    <VBox styleClass="form-card" maxWidth="500" spacing="15">
        <Label text="ADMINISTRATION" styleClass="section-eyebrow"/>
        <Label text="Edit Room" styleClass="section-heading"/>
        <TextField fx:id="roomNumberField" promptText="Room Number" styleClass="elegant-input"/>
        <ComboBox fx:id="typeCombo" promptText="Room Type" styleClass="elegant-input"/>
        
         <ListView fx:id="currentAmenitiesList" styleClass="elegant-list" prefHeight="100"/>
        <Button text="Remove Selected" onAction="#handleRemoveAmenity" styleClass="outline-action-btn"/>
        <HBox spacing="10">
            <ComboBox fx:id="availableAmenitiesCombo" promptText="Available Amenities" styleClass="elegant-input" HBox.hgrow="ALWAYS"/>
            <Button text="Add to Room" onAction="#handleAddAmenity" styleClass="primary-action-btn"/>
        </HBox>

        <Button text="Save Changes" onAction="#handleSave" styleClass="primary-action-btn"/>
        <Button text="Cancel" onAction="#handleCancel" styleClass="outline-action-btn"/>
    </VBox>
</VBox>
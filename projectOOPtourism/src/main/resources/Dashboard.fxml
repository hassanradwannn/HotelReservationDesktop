<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="720.0" prefWidth="1280.0" styleClass="root-pane" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="DashboardController">
   <top>
      <HBox alignment="CENTER_LEFT" prefHeight="80.0" spacing="22.0" style="-fx-background-color: #F9F3EA; -fx-border-color: transparent transparent #C9AA7C transparent; -fx-border-width: 0 0 1 0;">
         <padding><Insets bottom="18.0" left="30.0" right="30.0" top="18.0" /></padding>
         <children>
            <Label fx:id="titleLabel" text="Dashboard" textFill="#2b2421"><font><Font name="Georgia" size="34.0" /></font></Label>
            <Label fx:id="userLabel" text="Logged in as: User | Date: 2024-01-01" textFill="#8f1d3f"><font><Font name="Arial" size="14.0" /></font></Label>
         </children>
      </HBox>
   </top>
   <left>
      <VBox fx:id="sideMenu" prefWidth="260.0" spacing="12.0" style="-fx-background-color: #EFE4D6; -fx-border-color: transparent #C9AA7C transparent transparent; -fx-border-width: 0 1 0 0;">
         <padding><Insets bottom="25.0" left="25.0" right="25.0" top="25.0" /></padding>
      </VBox>
   </left>
   <center>
      <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">
         <content>
            <VBox fx:id="contentArea" spacing="15.0" style="-fx-background-color: #F9F3EA; -fx-background-radius: 18;">
               <padding><Insets bottom="30.0" left="30.0" right="30.0" top="30.0" /></padding>
            </VBox>
         </content>
      </ScrollPane>
   </center>
</BorderPane>
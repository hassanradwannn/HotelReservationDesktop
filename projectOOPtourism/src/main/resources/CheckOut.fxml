<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.text.Font?>

<VBox spacing="0" style="-fx-padding: 10;" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="CheckOutController">
    <children>
       <Label text="FRONT DESK" styleClass="panel-eyebrow"/>
       <Label text="Check Out Guest" styleClass="panel-title"/>
       <Region prefHeight="18"/>

       <VBox spacing="14" styleClass="form-card" maxWidth="500">
          <children>
             <ComboBox fx:id="reservationCombo" maxWidth="420.0" promptText="Select Ongoing Reservation" styleClass="elegant-input"/>
             <ComboBox fx:id="paymentCombo" maxWidth="420.0" promptText="Payment Method" styleClass="elegant-input"/>
             <Button onAction="#handleCheckOut" prefHeight="44.0" prefWidth="180.0" text="CHECK OUT" styleClass="primary-action-btn"/>
             <Label fx:id="messageLabel" styleClass="message-label"/>
          </children>
       </VBox>
    </children>
</VBox>

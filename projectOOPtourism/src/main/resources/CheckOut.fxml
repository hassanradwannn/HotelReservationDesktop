<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" spacing="20.0" style="-fx-background-color: #F7EFE5; -fx-padding: 20;" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="CheckOutController">
    <children>
        <Label text="Check Out Guest" styleClass="section-title">
            <font>
                <Font name="Georgia" size="29.0" />
            </font>
        </Label>
        <ComboBox fx:id="reservationCombo" maxWidth="420.0" promptText="Select Ongoing Reservation" />
        <ComboBox fx:id="paymentCombo" maxWidth="360.0" promptText="Payment Method" />
        <Button onAction="#handleCheckOut" prefHeight="42.0" prefWidth="170.0" text="CHECK OUT" styleClass="main-button" />
        <Label fx:id="messageLabel" styleClass="message-label" />
    </children>
</VBox>
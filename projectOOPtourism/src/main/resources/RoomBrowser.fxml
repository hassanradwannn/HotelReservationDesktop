<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.geometry.Insets?>

<VBox spacing="0" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="RoomBrowserController">

   <!-- Hero Banner -->
   <VBox styleClass="room-hero-banner" prefHeight="220" alignment="BOTTOM_LEFT">
      <padding><Insets top="0" left="60" right="60" bottom="0"/></padding>
      <children>
         <HBox alignment="BOTTOM_LEFT" spacing="6">
            <Label text="A most " styleClass="hero-room-text" textFill="#F9F3EA" style="-fx-text-fill: #F9F3EA;"/>
            <Label text="distinguished" styleClass="hero-room-italic" textFill="#D4C4BC" style="-fx-text-fill: #D4C4BC;"/>
         </HBox>
         <Label text="stay awaits you" styleClass="hero-room-text" textFill="#F9F3EA" style="-fx-text-fill: #F9F3EA;"/>
         <Label text="Begin curating your stay and exploring our finest offerings" styleClass="hero-room-sub" textFill="#D4C4BC" style="-fx-text-fill: #D4C4BC;"/>
         <Region prefHeight="28"/>
      </children>
   </VBox>

   <!-- Search / Filter Bar -->
   <VBox styleClass="search-bar-wrapper">
      <padding><Insets top="22" left="60" right="60" bottom="22"/></padding>
      <children>
         <HBox alignment="CENTER_LEFT" spacing="0" styleClass="search-bar-inner">
            <Label text="RESERVE YOUR SUITE" styleClass="search-bar-label">
               <padding><Insets left="18" right="18"/></padding>
            </Label>
            <Region HBox.hgrow="ALWAYS"/>
            <Button onAction="#loadRooms" text="SEARCH" styleClass="search-btn"/>
         </HBox>

         <HBox alignment="CENTER_LEFT" spacing="0" styleClass="search-fields-row">
            <VBox styleClass="search-field-group" HBox.hgrow="ALWAYS">
               <Label text="ROOM TYPE" styleClass="search-field-label"/>
               <ComboBox fx:id="typeFilter" promptText="Any Type" styleClass="search-field-combo" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            </VBox>
            <VBox styleClass="search-field-group" HBox.hgrow="ALWAYS">
               <Label text="PRICE / NIGHT" styleClass="search-field-label"/>
               <TextField fx:id="maxPrice" promptText="Max price" styleClass="search-field-input"/>
            </VBox>
         </HBox>
      </children>
   </VBox>

   <!-- Rooms Section -->
   <VBox VBox.vgrow="ALWAYS" styleClass="rooms-section">
      <padding><Insets top="28" left="60" right="60" bottom="30"/></padding>
      <children>
         <Label text="ACCOMMODATIONS" styleClass="section-eyebrow" textFill="#C4415D" style="-fx-text-fill: #C4415D;"/>
         <Label text="Our finest suites" styleClass="section-heading" textFill="#2C2523" style="-fx-text-fill: #2C2523;"/>
         <Region prefHeight="18"/>

         <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="transparent-scroll" prefHeight="380">
            <content>
               <VBox fx:id="roomCards" spacing="0"/>
            </content>
         </ScrollPane>
      </children>
   </VBox>

</VBox>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.geometry.Insets?>

<VBox spacing="0" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="RoomBrowserController">

   <!-- Hero Banner -->
   <VBox styleClass="room-hero-banner" prefHeight="220" alignment="BOTTOM_LEFT">
      <padding><Insets top="0" left="60" right="60" bottom="0"/></padding>
      <children>
         <HBox alignment="BOTTOM_LEFT" spacing="6">
            <Label text="A most " styleClass="hero-room-text"/>
            <Label text="distinguished" styleClass="hero-room-italic"/>
         </HBox>
         <Label text="stay awaits you" styleClass="hero-room-text"/>
         <Label text="Begin curating your stay and exploring our finest offerings" styleClass="hero-room-sub"/>
         <Region prefHeight="28"/>
      </children>
   </VBox>

   <!-- Search / Filter Bar -->
   <VBox styleClass="search-bar-wrapper">
      <padding><Insets top="22" left="60" right="60" bottom="22"/></padding>
      <children>
         <HBox alignment="CENTER_LEFT" spacing="0" styleClass="search-bar-inner">
            <Label text="RESERVE YOUR SUITE" styleClass="search-bar-label">
               <padding><Insets left="18" right="18"/></padding>
            </Label>
            <Region HBox.hgrow="ALWAYS"/>
            <Button onAction="#loadRooms" text="SEARCH" styleClass="search-btn"/>
         </HBox>

         <HBox alignment="CENTER_LEFT" spacing="0" styleClass="search-fields-row">
            <VBox styleClass="search-field-group" HBox.hgrow="ALWAYS">
               <Label text="ROOM TYPE" styleClass="search-field-label"/>
               <ComboBox fx:id="typeFilter" promptText="Any Type" styleClass="search-field-combo" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            </VBox>
            <VBox styleClass="search-field-group" HBox.hgrow="ALWAYS">
               <Label text="PRICE / NIGHT" styleClass="search-field-label"/>
               <TextField fx:id="maxPrice" promptText="Max price" styleClass="search-field-input"/>
            </VBox>
            <VBox styleClass="search-field-group" HBox.hgrow="ALWAYS">
               <Label text="REQUIRED AMENITIES" styleClass="search-field-label"/>
               <HBox spacing="15" alignment="CENTER_LEFT">
                  <padding><Insets top="5" bottom="5"/></padding>
                  <CheckBox fx:id="minibarBox" text="Mini-bar" styleClass="elegant-check"/>
                  <CheckBox fx:id="jacuzziBox" text="Jacuzzi" styleClass="elegant-check"/>
                  <CheckBox fx:id="gymBox" text="Gym" styleClass="elegant-check"/>
               </HBox>
            </VBox>
         </HBox>
      </children>
   </VBox>

   <!-- Rooms Section -->
   <VBox VBox.vgrow="ALWAYS" styleClass="rooms-section">
      <padding><Insets top="28" left="60" right="60" bottom="30"/></padding>
      <children>
         <Label text="ACCOMMODATIONS" styleClass="section-eyebrow"/>
         <Label text="Our finest suites" styleClass="section-heading"/>
         <Region prefHeight="18"/>

         <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="transparent-scroll">
            <content>
               <FlowPane fx:id="roomCards" hgap="30" vgap="30" alignment="TOP_LEFT"/>
            </content>
         </ScrollPane>
      </children>
   </VBox>

</VBox>

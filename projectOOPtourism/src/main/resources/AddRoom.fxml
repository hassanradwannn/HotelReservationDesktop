<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" spacing="20.0" style="-fx-background-color: #F7EFE5; -fx-padding: 20;" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="AddRoomController">
    <children>
        <Label text="Add Room" styleClass="section-title">
            <font>
                <Font name="Georgia" size="29.0" />
            </font>
        </Label>
        <TextField fx:id="roomNumberField" maxWidth="360.0" promptText="Room Number" styleClass="input-field" />
        <ComboBox fx:id="typeCombo" maxWidth="360.0" promptText="Room Type" style="-fx-background-color: #FFFFFF; -fx-background-radius: 8; -fx-border-color: #C9AA7C; -fx-border-radius: 8; -fx-padding: 5; -fx-font-size: 14px;" />
        <Button onAction="#handleAdd" prefHeight="42.0" prefWidth="160.0" text="ADD ROOM" styleClass="main-button" />
    </children>
</VBox>
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.text.Font?>

<VBox spacing="0" style="-fx-padding: 10;" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.AddRoomController">
    <children>
       <Label text="ADMINISTRATION" styleClass="panel-eyebrow"/>
       <Label text="Add Room" styleClass="panel-title"/>
       <Region prefHeight="18"/>

       <VBox spacing="14" styleClass="form-card" maxWidth="500">
          <children>
             <TextField fx:id="roomNumberField" maxWidth="420.0" promptText="Room Number" styleClass="elegant-input"/>
             <ComboBox fx:id="typeCombo" maxWidth="420.0" promptText="Room Type" styleClass="elegant-input"/>
             <Button onAction="#handleAdd" prefHeight="44.0" prefWidth="160.0" text="ADD ROOM" styleClass="primary-action-btn"/>
          </children>
       </VBox>
    </children>
</VBox>

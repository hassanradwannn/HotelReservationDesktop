<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.shape.*?>

<AnchorPane prefHeight="720.0" prefWidth="1280.0" styleClass="root-pane" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="LoginController">
   <children>
      <HBox AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">

         <!-- Left Panel: Branding -->
         <VBox prefWidth="560.0" styleClass="login-left-panel" alignment="BOTTOM_LEFT">
            <padding><Insets top="0" left="0" right="0" bottom="0"/></padding>
            <children>
               <!-- Greek meander border top -->

               <VBox VBox.vgrow="ALWAYS" alignment="CENTER_LEFT" spacing="20">
                  <padding><Insets top="60" left="65" right="65" bottom="60"/></padding>
                  <children>
                     <Label text="Your stay," styleClass="hero-text-light" textFill="#F9F3EA" style="-fx-text-fill: #F9F3EA;"/>
                     <Label text="remembered" styleClass="hero-text-italic" textFill="#C8B8B0" style="-fx-text-fill: #C8B8B0;"/>
                     <Label text="forever." styleClass="hero-text-light" textFill="#F9F3EA" style="-fx-text-fill: #F9F3EA;"/>
                     <Region prefHeight="18"/>
                     <Label text="&quot;A person's life is his identity. Let us help you maintain yours.&quot; Sign in to your account to view availability and manage your upcoming stay." styleClass="hero-subtext" textFill="#D4C4BC" style="-fx-text-fill: #D4C4BC;" wrapText="true" maxWidth="400"/>
                  </children>
               </VBox>

               <Label text="Est. 1908  ·  Cairo, Arab Republic of Egypt" styleClass="hotel-footer-label" textFill="#B8A89E" style="-fx-text-fill: #B8A89E;">
                  <padding><Insets left="65" bottom="35"/></padding>
               </Label>
            </children>
         </VBox>

         <!-- Right Panel: Form -->
         <VBox prefWidth="720.0" styleClass="login-right-panel" alignment="TOP_LEFT">
            <children>
               <!-- Greek meander border top -->

               <VBox VBox.vgrow="ALWAYS" alignment="CENTER_LEFT" spacing="22">
                  <padding><Insets top="60" left="100" right="100" bottom="60"/></padding>
                  <children>
                     <Label text="WELCOME BACK" styleClass="form-eyebrow" textFill="#C4415D" style="-fx-text-fill: #C4415D;"/>
                     <Label text="Sign in to your account" styleClass="form-title" textFill="#2C2523" style="-fx-text-fill: #2C2523;"/>

                     <Region prefHeight="10"/>

                     <TextField fx:id="usernameField" promptText="username" styleClass="elegant-input" maxWidth="460"/>
                     <PasswordField fx:id="passwordField" promptText="password" styleClass="elegant-input" maxWidth="460"/>

                     <Region prefHeight="4"/>

                     <Button fx:id="loginBtn" text="LOGIN IN" onAction="#handleLogin" prefHeight="50" prefWidth="220" styleClass="primary-action-btn"/>

                     <HBox spacing="6" alignment="CENTER_LEFT">
                        <Label text="Don't have an account?" styleClass="form-link-label"/>
                        <Hyperlink text="Sign up" onAction="#handleRegister" styleClass="form-link"/>
                     </HBox>

                     <Hyperlink text="Forgot your password?" onAction="#handleForgotPassword" styleClass="form-link"/>

                     <Label fx:id="messageLabel" styleClass="message-label" wrapText="true" maxWidth="460"/>
                     <Label text="Demo: Admin / Admin@123 | Hassan / Hassan123 | Manar / Manar2002" styleClass="demo-hint" wrapText="true" maxWidth="460"/>
                  </children>
               </VBox>
            </children>
         </VBox>

      </HBox>
   </children>
</AnchorPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="720.0" prefWidth="1280.0" styleClass="root-pane" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="LoginController">
   <children>
      <HBox AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">

         <!-- Left Panel: Branding -->
         <VBox alignment="BOTTOM_LEFT" prefWidth="560.0" styleClass="login-left-panel">
            <padding><Insets bottom="0" left="0" right="0" top="0" /></padding>
            <children>
               <!-- Greek meander border top -->

               <VBox alignment="CENTER_LEFT" spacing="20" VBox.vgrow="ALWAYS">
                  <padding><Insets bottom="60" left="65" right="65" top="60" /></padding>
                  <children>
                     <Label style="-fx-text-fill: #F9F3EA;" styleClass="hero-text-light" text="Your stay," textFill="#F9F3EA" />
                     <Label style="-fx-text-fill: #C8B8B0;" styleClass="hero-text-italic" text="remembered" textFill="#C8B8B0" />
                     <Label style="-fx-text-fill: #F9F3EA;" styleClass="hero-text-light" text="forever." textFill="#F9F3EA" />
                     <Region prefHeight="18" />
                     <Label maxWidth="400" style="-fx-text-fill: #D4C4BC;" styleClass="hero-subtext" text="&quot;A person's life is his identity. Let us help you maintain yours.&quot; Sign in to your account to view availability and manage your upcoming stay." textFill="#D4C4BC" wrapText="true" />
                  </children>
               </VBox>

               <Label style="-fx-text-fill: #B8A89E;" styleClass="hotel-footer-label" text="Est. 1908  ·  Cairo, Arab Republic of Egypt" textFill="#B8A89E">
                  <padding><Insets bottom="35" left="65" /></padding>
               </Label>
            </children>
         </VBox>

         <!-- Right Panel: Form -->
         <VBox alignment="TOP_LEFT" prefWidth="720.0" styleClass="login-right-panel">
            <children>
               <!-- Greek meander border top -->

               <VBox alignment="CENTER_LEFT" spacing="22" VBox.vgrow="ALWAYS">
                  <padding><Insets bottom="60" left="100" right="100" top="60" /></padding>
                  <children>
                     <Label style="-fx-text-fill: #C4415D;" styleClass="form-eyebrow" text="WELCOME BACK" textFill="#C4415D" />
                     <Label style="-fx-text-fill: #2C2523;" styleClass="form-title" text="Sign in to your account" textFill="#2C2523" />

                     <Region prefHeight="10" />

                     <TextField fx:id="usernameField" maxWidth="460" promptText="username" styleClass="elegant-input" />
                     <PasswordField fx:id="passwordField" maxWidth="460" promptText="password" styleClass="elegant-input" />

                     <Region prefHeight="4" />

                     <Button fx:id="loginBtn" onAction="#handleLogin" prefHeight="50" prefWidth="220" styleClass="primary-action-btn" text="LOGIN" />

                     <HBox alignment="CENTER_LEFT" spacing="6">
                        <Label styleClass="form-link-label" text="Don't have an account?" />
                        <Hyperlink onAction="#handleRegister" styleClass="form-link" text="Sign up" />
                     </HBox>

                     <Hyperlink onAction="#handleForgotPassword" styleClass="form-link" text="Forgot your password?" />

                     <Label fx:id="messageLabel" maxWidth="460" styleClass="message-label" wrapText="true" />
                     <Label maxWidth="460" styleClass="demo-hint" text="Demo: Admin / Admin@123 | Hassan / Hassan123 | Manar / Manar2002" wrapText="true" />
                  </children>
               </VBox>
            </children>
         </VBox>

      </HBox>
   </children>
</AnchorPane>

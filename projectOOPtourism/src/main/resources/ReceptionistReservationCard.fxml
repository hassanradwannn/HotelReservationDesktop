<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="root"
           maxWidth="Infinity"
           pickOnBounds="true"
           stylesheets="@styles.css"
           xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="Controllers.ReceptionistReservationCardController">
    <children>
        <HBox fx:id="cardBody" alignment="CENTER_LEFT" maxWidth="Infinity" spacing="0" mouseTransparent="false">

            <!-- Left accent bar -->
            <Region fx:id="accentBar" minWidth="6" maxWidth="6" prefWidth="6"
                    style="-fx-min-height: 120; -fx-pref-height: 120;"/>

            <!-- Card content -->
            <HBox alignment="CENTER_LEFT" maxWidth="Infinity" HBox.hgrow="ALWAYS">
                <padding><Insets bottom="22" left="22" right="22" top="22"/></padding>
                <children>

                    <!-- Avatar circle -->
                    <StackPane fx:id="avatarPane" minWidth="56" minHeight="56" maxWidth="56" maxHeight="56"
                               style="-fx-background-radius: 50; -fx-min-width: 56; -fx-min-height: 56; -fx-max-width: 56; -fx-max-height: 56;">
                        <Label fx:id="iconLabel" style="-fx-font-family: 'Georgia'; -fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white; -fx-alignment: center;"/>
                    </StackPane>

                    <Region minWidth="18" maxWidth="18"/>

                    <!-- Main info block -->
                    <VBox alignment="CENTER_LEFT" spacing="6" HBox.hgrow="ALWAYS">
                        <children>
                            <!-- Guest name + sub line -->
                            <Label fx:id="typeNameText" styleClass="card-guest-name"/>
                            <Label fx:id="subLineLabel"  styleClass="card-sub-line"/>

                            <!-- Metrics row -->
                            <HBox alignment="CENTER_LEFT" spacing="36" style="-fx-padding: 6 0 0 0;">
                                <children>
                                    <VBox spacing="2">
                                        <Label fx:id="checkInHeaderLabel"  text="CHECK-IN"  styleClass="card-metric-header"/>
                                        <Label fx:id="checkInValueLabel"               styleClass="card-metric-value"/>
                                    </VBox>
                                    <VBox spacing="2">
                                        <Label fx:id="checkOutHeaderLabel" text="CHECK-OUT" styleClass="card-metric-header"/>
                                        <Label fx:id="checkOutValueLabel"              styleClass="card-metric-value"/>
                                    </VBox>
                                    <VBox spacing="2">
                                        <Label fx:id="paidHeaderLabel"     text="TOTAL"     styleClass="card-metric-header"/>
                                        <Label fx:id="paidValueLabel"                  styleClass="card-metric-value"/>
                                    </VBox>
                                    <!-- hidden but required by controller -->
                                    <Label fx:id="guestHeaderLabel"      visible="false" managed="false" text="GUEST"/>
                                    <Label fx:id="guestValueLabel"       visible="false" managed="false"/>
                                    <Label fx:id="outstandingHeaderLabel" visible="false" managed="false" text="OUTSTANDING"/>
                                    <Label fx:id="outstandingValueLabel" visible="false" managed="false"/>
                                </children>
                            </HBox>
                        </children>
                    </VBox>

                </children>
            </HBox>

            <!-- Right side: status top, actions bottom -->
            <VBox alignment="TOP_RIGHT" spacing="0" style="-fx-padding: 18 22 18 0;" minHeight="120" prefHeight="120">
                <children>
                    <Label fx:id="statusBadgeLabel" styleClass="status-badge" VBox.vgrow="NEVER"/>
                    <Region VBox.vgrow="ALWAYS"/>
                    <HBox fx:id="actionBox" alignment="CENTER_RIGHT" spacing="10" VBox.vgrow="NEVER"/>
                </children>
            </VBox>

        </HBox>
    </children>
</StackPane>

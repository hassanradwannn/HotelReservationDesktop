<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.text.Font?>

<VBox spacing="0" style="-fx-padding: 10;" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.ChatController">
    <children>
       <Label text="CONCIERGE" styleClass="panel-eyebrow"/>
       <Label text="Live Reception Chat" styleClass="panel-title"/>
       <Region prefHeight="14"/>

       <VBox styleClass="chat-card" VBox.vgrow="ALWAYS" spacing="14">
          <children>
             <HBox fx:id="header" alignment="CENTER_LEFT" spacing="14">
                <StackPane fx:id="avatar" prefHeight="46" prefWidth="46" style="-fx-background-color: #C74261; -fx-background-radius: 50;">
                   <Label fx:id="avatarText" text="U" style="-fx-text-fill: WHITE; -fx-font-weight: bold; -fx-font-size: 20;"/>
                </StackPane>
                <VBox spacing="2">
                   <Label fx:id="chatName" text="Hotel Live Chat" styleClass="chat-name"/>
                   <Label fx:id="chatStatus" text="Select a chat" styleClass="chat-status"/>
                </VBox>
             </HBox>

             <TextArea fx:id="chatArea" editable="false" prefHeight="380" styleClass="chat-area" wrapText="true" VBox.vgrow="ALWAYS"/>

             <HBox alignment="CENTER" spacing="10">
                <TextField fx:id="inputField" promptText="Write your message..." styleClass="elegant-input" HBox.hgrow="ALWAYS"/>
                <Button fx:id="sendButton" onAction="#handleSend" prefHeight="44" prefWidth="110" text="SEND" styleClass="primary-action-btn"/>
             </HBox>
          </children>
       </VBox>
    </children>
</VBox>
